{
  "login": {
    "request": {
      "method": "POST",
      "url": "http://127.0.0.1:18066/login",
      "body": {
        "username": "alice",
        "password": "[REDACTED_PASSWORD]"
      }
    },
    "response": {
      "status": 200,
      "body": {
        "token": "REDACTED_TOKEN_2"
      }
    }
  },
  "execution": {
    "request": {
      "method": "POST",
      "url": "http://127.0.0.1:18066/assistant/execute",
      "headers": {
        "Content-Type": "application/json",
        "X-Token": "REDACTED_TOKEN_2"
      },
      "body": {
        "decision": {
          "tool": "refuse",
          "arguments": {
            "reason": "Невозможно подтвердить, что заказ 1 принадлежит пользователю."
          }
        }
      }
    },
    "response": {
      "status": 400,
      "body": {
        "error": "unknown tool"
      }
    }
  }
}
